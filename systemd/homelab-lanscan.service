[Unit]
Description=Process queued or scheduled Homelab Control LAN scans
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Development/homelab-control
Environment=LANSCAN_NETWORK=192.168.1.0/24
Environment=LANSCAN_WITH_OPNSENSE=1
ExecStart=/usr/bin/python3 %h/Development/homelab-control/scripts/lanscan-worker.py
TimeoutStartSec=210
