FRONTEND_PORT=8080
BACKEND_PORT=3001

# Optional multi-server Proxmox discovery (JSON containing local secrets)
# First copy config/proxmox-instances.example.json to config/proxmox-instances.json
# Then set PROXMOX_INSTANCES_FILE=/app/config/proxmox-instances.json
PROXMOX_INSTANCES_FILE=

# Legacy single-server settings (ignored if PROXMOX_INSTANCES_FILE is set)
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
# If using the Proxmox built-in CA, place its public cert in ./certs/ and set:
# PROXMOX_CA_PATH=/app/certs/proxmox-ca.pem

# Infisical (self-hosted, Universal Auth Machine Identity)
# Project ID is from Infisical Project Settings; environment dev is already in use.
INFISICAL_SITE_URL=https://secrets.example.invalid
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_SECRET_PATH=/
INFISICAL_CLIENT_ID=
# Recommended: create ./secrets/infisical-client-secret, chmod 600, then use:
INFISICAL_CLIENT_SECRET_FILE=
# Alternative local bootstrap credential; NEVER commit actual values:
INFISICAL_CLIENT_SECRET=
# Optional additional trusted public CA certificate for self-hosted Infisical
# Mount the cert under ./certs; set this to /app/certs/infisical-ca.pem
INFISICAL_CA_PATH=

# Sprint 3D: internal Pushover Proxy notifications (OFF until explicitly enabled).
# Backend-only fixed POST /api/pushover/send {title,text}; no Pushover secrets.
# The service must be reachable on your trusted LAN from the backend host.
NETWORK_NOTIFICATIONS_ENABLED=false
NETWORK_NOTIFICATIONS_PROXY_URL=http://api.ulnihnw.net/api/pushover/send
# Default events: new ARP-discovered devices and IP conflicts.
# Other choices: DEVICE_ONLINE, DEVICE_OFFLINE, IP_CHANGED, MAC_CHANGED,
# CONFLICT_RESOLVED, DHCP_CHANGED. Comma-separated, server-side only.
NETWORK_NOTIFICATIONS_EVENT_TYPES=NEW_DEVICE,IP_CONFLICT
NETWORK_NOTIFICATIONS_COOLDOWN_MINUTES=60

# Sprint 3E: independent LAN-only Discord Proxy.
# Uses POST /api/discord/send with JSON {"text":"..."}. No webhook URL, bot token,
# Discord credentials or direct discord.com traffic in Homelab Control.
# OFF by default; allowlist events separately from Pushover, if desired.
NETWORK_DISCORD_NOTIFICATIONS_ENABLED=false
NETWORK_DISCORD_NOTIFICATIONS_PROXY_URL=http://api.ulnihnw.net/api/discord/send
NETWORK_DISCORD_NOTIFICATIONS_EVENT_TYPES=NEW_DEVICE,IP_CONFLICT
NETWORK_DISCORD_NOTIFICATIONS_COOLDOWN_MINUTES=60

# Sprint 3A: Direct LAN scanning is part of the backend Docker container.
# The backend uses Linux host networking for ARP visibility. BACKEND_PORT is
# the actual port it listens on (3001 Lenovo, 3002 ThinkPad).
# The fixed subnet is used for both manual and 15-minute automatic scans.
LANSCAN_NETWORK=192.168.1.0/24
# false: ARP and reverse DNS only. true: also use OPNsense ISC DHCP leases.
# OPNsense API credentials are ONLY in Infisical; reuse the existing Infisical
# Machine Identity configuration already used by Proxmox.
LANSCAN_WITH_OPNSENSE=false
LANSCAN_OPNSENSE_URL=https://opnsense.ulnihnw.net
LANSCAN_OPNSENSE_API_KEY_REF=OPNSENSE_API_KEY
LANSCAN_OPNSENSE_API_SECRET_REF=OPNSENSE_API_SECRET
# Optional trusted PUBLIC CA certificate if OPNsense uses its own CA.
# The TLS certificate must match the hostname in LANSCAN_OPNSENSE_URL.
LANSCAN_OPNSENSE_CA_PATH=
